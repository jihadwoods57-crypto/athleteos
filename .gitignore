# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# local bundle export (verification only)
.aos-export/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (keep .env.example tracked; ignore real secrets, incl. backups like .env.prod.bak)
.env*
!.env.example

# Playwright MCP browser-session output (screenshots/logs from QA agents)
.playwright-mcp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local dev artifacts
aos-qr.png

# dev QR / scratch images
aos-dev-qr*.png

# iOS local build credentials (never commit)
credentials.json
ios-certs/
.digest-cron-key.local

# Scratch/intermediate work per CLAUDE.md ("everything in .tmp/ is disposable"). This was NOT
# ignored until 2026-07-30, which meant a `git add -A` would have committed whatever a tool had
# dropped there — including generated cron keys (.tmp/*-cron-key.local). Regenerable by design;
# never worth committing, and occasionally a secret.
.tmp/
*-cron-key.local

# Python bytecode from the landing-page tooling.
__pycache__/
*.pyc

# Local OnStandard media + loose secrets (organization only — not part of the shipped app)
_media/
_secrets/
sim/
.fable5/shots/persona-sim/

# wrangler local state/cache
web/landing-src/deploy/.wrangler/

# Agent skill installs (symlink farm — breaks the EAS tarball on Windows; tooling-only, not app code)
.claude/skills/
.agents/skills/
skills-lock.json
scripts/.security-baseline.json
scripts/.security-sweep.log

# QC / audit render output. Generated by the screenshot harnesses on demand and regenerated freely —
# 131 untracked entries here were burying real changes in `git status`, which is how a concurrent
# agent's work gets missed or a stray file gets swept into someone else's commit.
qc/
*.jpeg
!eval/meals/*.jpeg
baseline-*.png
art*-final.png

# Commercial/demo video pipeline output (2026-07-31). The Remotion renderer and the landing-page
# QC pass both drop stills, ffmpeg logs and numbered section screenshots beside their sources on
# every run — 30 more untracked entries on top of the 131 the qc/ block above was written for.
# Deliberately NOT a blanket *.jpg: proto/redesign-2026-07/assets/*.jpg are shipped app assets that
# ride inside proto.zip, and an ignore broad enough to swallow a new one would break an OTA
# silently, which is the exact failure this file is supposed to prevent.
/[0-9][0-9]-*.jpg
scripts/commercial/qc-*.jpg
scripts/commercial/remotion/*.png
scripts/commercial/remotion/render-*.txt

# Licensed music + rendered commercial/demo videos. ~226 MB of .mp4 and the purchased audio behind
# them. Kept out of git on purpose — the repo already carries 282 MB of tracked binaries — but that
# means THESE FILES EXIST ONLY ON THIS MACHINE. They are deliverables, not build output: a lost
# disk loses the licensed tracks and every render. They belong in object storage, not here.
# hero-loop.mp4 is deliberately not matched: it is tracked, and the live site serves it.
scripts/commercial/music/
web/landing/assets/video/commercial-*.mp4
web/landing/assets/video/demo-*.mp4

# Subagent-driven-development scratch (ledgers, briefs, review packages)
.superpowers/

# Git worktrees for isolated plan execution
.worktrees/
