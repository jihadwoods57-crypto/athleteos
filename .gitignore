# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# local bundle export (verification only)
.aos-export/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files (keep .env.example tracked; ignore real secrets, incl. backups like .env.prod.bak)
.env*
!.env.example

# Playwright MCP browser-session output (screenshots/logs from QA agents)
.playwright-mcp/

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# local dev artifacts
aos-qr.png

# dev QR / scratch images
aos-dev-qr*.png

# iOS local build credentials (never commit)
credentials.json
ios-certs/
.digest-cron-key.local

# Scratch/intermediate work per CLAUDE.md ("everything in .tmp/ is disposable"). This was NOT
# ignored until 2026-07-30, which meant a `git add -A` would have committed whatever a tool had
# dropped there — including generated cron keys (.tmp/*-cron-key.local). Regenerable by design;
# never worth committing, and occasionally a secret.
.tmp/
*-cron-key.local

# Python bytecode from the landing-page tooling.
__pycache__/
*.pyc

# Local OnStandard media + loose secrets (organization only — not part of the shipped app)
_media/
_secrets/
sim/
.fable5/shots/persona-sim/

# wrangler local state/cache
web/landing-src/deploy/.wrangler/

# Agent skill installs (symlink farm — breaks the EAS tarball on Windows; tooling-only, not app code)
.claude/skills/
.agents/skills/
skills-lock.json
scripts/.security-baseline.json
scripts/.security-sweep.log

# QC / audit render output. Generated by the screenshot harnesses on demand and regenerated freely —
# 131 untracked entries here were burying real changes in `git status`, which is how a concurrent
# agent's work gets missed or a stray file gets swept into someone else's commit.
qc/
*.jpeg
!eval/meals/*.jpeg
baseline-*.png
art*-final.png
